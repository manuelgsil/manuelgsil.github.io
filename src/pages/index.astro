---
import Layout from "../layouts/Layout.astro";
import IconSprites from "../components/IconSprites.astro";
import Curtain from "../components/Curtain.astro";
import FloatingIcons from "../components/FloatingIcons.astro";
import Hero from "../components/Hero.astro";
import Marquee from "../components/Marquee.astro";
import About from "../components/About.astro";
import Experience from "../components/Experience.astro";
import Stack from "../components/Stack.astro";
import Projects from "../components/Projects.astro";
import Education from "../components/Education.astro";
import Guestbook from "../components/Guestbook.astro";
import Footer from "../components/Footer.astro";
---

<Layout
  title="Manuel's Web Page"
  description="Manuel Guillén · Desarrollador PHP y Laravel en Sevilla."
>
  <IconSprites />
  <Curtain />

  <div class="page">
    <FloatingIcons />

    <div class="window">
      <div class="titlebar">
        <div class="dot"></div>
        <div class="dashes"></div>
        <span>manuel-web-page.html</span>
        <div class="dashes"></div>
        <div class="dot"></div>
      </div>

      <Hero />
      <Marquee />

      <div class="sections">
        <About />
        <Experience />
        <Stack />
        <Projects />
        <Education />
        <Guestbook />
      </div>

      <Footer />
    </div>
  </div>
</Layout>

<style>
  .page {
    min-height: 100vh;
    background: var(--ac);
    padding: 26px 16px 70px;
    position: relative;
    overflow: hidden;
  }

  .window {
    max-width: 1040px;
    margin: 0 auto;
    position: relative;
    border: 4px solid var(--ink);
    border-radius: 6px;
    background: var(--paper);
    box-shadow: 12px 12px 0 rgba(0, 0, 0, 0.4);
  }

  .titlebar {
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 7px 11px;
    border-bottom: 4px solid var(--ink);
    background: var(--panel);
    font-size: 13px;
    font-weight: 700;
    white-space: nowrap;
  }

  .dot {
    width: 14px;
    height: 14px;
    border: 2px solid var(--ink);
    background: var(--paper);
    flex: none;
  }

  .dashes {
    flex: 1;
    height: 11px;
    background: repeating-linear-gradient(var(--ink) 0 2px, transparent 2px 4px);
  }

  .sections {
    padding: 36px 26px 44px;
    display: grid;
    gap: 36px;
  }

  .sections > :global(*) {
    min-width: 0;
  }
</style>
