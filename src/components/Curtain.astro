---
---

<div id="curtain" class="curtain">
  <div class="panel panel-left"></div>
  <div class="panel panel-right"></div>
  <div class="content">
    <div class="title">Manuel's<br />Web Page</div>
    <div class="icons">
      <svg style="width: 54px; animation: entra-icono 2.6s ease-out 0.5s forwards; opacity: 0"><use href="#ico-tostadora" /></svg>
      <svg style="width: 48px; animation: entra-icono 2.6s ease-out 0.62s forwards; opacity: 0"><use href="#ico-perro" /></svg>
      <svg style="width: 44px; animation: entra-icono 2.6s ease-out 0.74s forwards; opacity: 0"><use href="#ico-disquete" /></svg>
      <svg style="width: 56px; animation: entra-icono 2.6s ease-out 0.86s forwards; opacity: 0"><use href="#ico-php" /></svg>
      <svg style="width: 48px; animation: entra-icono 2.6s ease-out 0.98s forwards; opacity: 0"><use href="#ico-libro" /></svg>
      <svg style="width: 40px; animation: entra-icono 2.6s ease-out 1.1s forwards; opacity: 0"><use href="#ico-cafe" /></svg>
    </div>
    <div class="hint">CLIC PARA SALTAR</div>
  </div>
</div>

<style>
  .curtain {
    position: fixed;
    inset: 0;
    z-index: 999;
    cursor: pointer;
    overflow: hidden;
    font-family: "Space Mono", monospace;
  }

  .panel {
    position: absolute;
    top: 0;
    width: 50.5%;
    height: 100%;
    background: repeating-linear-gradient(
      90deg,
      #6e1108 0 18px,
      #a8271a 34px,
      #c4392a 52px,
      #a8271a 70px,
      #6e1108 88px
    );
  }

  .panel-left {
    left: 0;
    animation: cortina-izq 3s cubic-bezier(0.7, 0, 0.3, 1) forwards;
  }

  .panel-right {
    right: 0;
    animation: cortina-der 3s cubic-bezier(0.7, 0, 0.3, 1) forwards;
  }

  .content {
    position: absolute;
    inset: 0;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    gap: 30px;
    pointer-events: none;
  }

  .title {
    font-family: Georgia, "Times New Roman", serif;
    font-weight: 700;
    font-size: clamp(34px, 8vw, 88px);
    line-height: 1.05;
    color: var(--ink);
    letter-spacing: -1px;
    text-align: center;
    text-shadow:
      3px 0 0 #fff,
      -3px 0 0 #fff,
      0 3px 0 #fff,
      0 -3px 0 #fff,
      3px 3px 0 #fff,
      -3px -3px 0 #fff,
      3px -3px 0 #fff,
      -3px 3px 0 #fff;
    animation: entra-titulo 3s ease-out forwards;
  }

  .icons {
    display: flex;
    gap: 22px;
    align-items: center;
  }

  .hint {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 3px;
    color: var(--paper);
    opacity: 0.65;
  }

  .curtain.hidden {
    display: none;
  }
</style>

<script>
  const curtain = document.getElementById("curtain");
  const SEEN_KEY = "curtain-seen";

  if (curtain) {
    let alreadySeen = false;
    try {
      alreadySeen = localStorage.getItem(SEEN_KEY) === "1";
    } catch {
      // localStorage no disponible (modo privado, etc.) — se muestra la cortinilla igual.
    }

    if (alreadySeen) {
      curtain.classList.add("hidden");
    } else {
      const dismiss = () => {
        curtain.classList.add("hidden");
        try {
          localStorage.setItem(SEEN_KEY, "1");
        } catch {
          // nada que hacer si no se puede guardar
        }
      };
      curtain.addEventListener("click", dismiss);
      setTimeout(dismiss, 3050);
    }
  }
</script>
