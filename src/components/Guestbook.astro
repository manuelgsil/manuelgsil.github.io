---
---

<section>
  <h2>Libro de visitas</h2>
  <div class="card">
    <p class="hint">Firma si has llegado hasta aquí — se guarda de verdad, pero solo 1 día. Aprovecha.</p>
    <p id="gb-error" class="error" hidden></p>
    <div id="firmas" class="firmas">
      <p class="cargando">Cargando firmas…</p>
    </div>
    <form id="guestbook-form" class="form">
      <input id="gb-nombre" name="nombre" placeholder="Tu nombre" maxlength="40" />
      <input id="gb-mensaje" name="mensaje" placeholder="Tu mensaje" maxlength="200" required />
      <div class="cf-turnstile" data-sitekey="0x4AAAAAAEiMpHIiP4Zx3cMv" data-size="flexible"></div>
      <button type="submit">Firmar</button>
    </form>
  </div>
</section>

<template id="firma-template">
  <div class="firma">
    <div class="autor"><span data-field="nombre"></span> <span class="fecha" data-field="fecha"></span></div>
    <div class="mensaje" data-field="mensaje"></div>
  </div>
</template>

<style>
  h2 {
    margin: 0 0 14px;
    font-family: Georgia, serif;
    font-size: 32px;
    letter-spacing: -0.5px;
  }

  .card {
    border: 4px solid var(--ink);
    background: #fff;
    padding: 22px;
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.25);
  }

  .hint {
    margin: 0 0 16px;
    font-size: 14px;
    font-style: italic;
  }

  .error {
    margin: 0 0 16px;
    font-size: 14px;
    font-weight: 700;
    color: #a8271a;
  }

  .cargando {
    margin: 0;
    font-size: 14px;
    opacity: 0.6;
  }

  .firmas {
    display: grid;
    gap: 12px;
  }

  .firma {
    border-left: 6px solid var(--ac);
    padding: 4px 0 4px 14px;
  }

  .autor {
    font-size: 14px;
    font-weight: 700;
  }

  .fecha {
    font-weight: 400;
    opacity: 0.55;
  }

  .mensaje {
    font-size: 15px;
    margin-top: 3px;
  }

  .form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  input {
    font-family: "Space Mono", monospace;
    font-size: 15px;
    padding: 10px 12px;
    border: 3px solid var(--ink);
    background: var(--paper);
  }

  #gb-nombre {
    flex: 1 1 160px;
  }

  #gb-mensaje {
    flex: 2 1 240px;
  }

  .cf-turnstile {
    flex: 1 0 100%;
    width: 100%;
  }

  button {
    font-family: "Space Mono", monospace;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    color: var(--ac);
    background: var(--ink);
    border: 3px solid var(--ink);
    padding: 10px 18px;
    box-shadow: 4px 4px 0 var(--ac);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  button:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--ac);
  }

  button:disabled {
    cursor: not-allowed;
    opacity: 0.6;
  }
</style>

<script>
  const API = "https://manuelgsil-guestbook.guillenmanuel993.workers.dev/firmas";

  const form = document.getElementById("guestbook-form") as HTMLFormElement | null;
  const firmasEl = document.getElementById("firmas");
  const errorEl = document.getElementById("gb-error");
  const template = document.getElementById("firma-template") as HTMLTemplateElement | null;

  function renderFirma(v: { nombre: string; mensaje: string; fecha: string }) {
    if (!template) return null;
    const node = template.content.cloneNode(true) as DocumentFragment;
    node.querySelector<HTMLElement>('[data-field="nombre"]')!.textContent = v.nombre;
    node.querySelector<HTMLElement>('[data-field="fecha"]')!.textContent = `· ${v.fecha}`;
    node.querySelector<HTMLElement>('[data-field="mensaje"]')!.textContent = v.mensaje;
    return node;
  }

  function mostrarError(msg: string) {
    if (!errorEl) return;
    errorEl.textContent = msg;
    errorEl.hidden = false;
  }

  async function cargarFirmas() {
    if (!firmasEl) return;
    try {
      const res = await fetch(API);
      const data = await res.json();
      firmasEl.innerHTML = "";
      if (!data.firmas || data.firmas.length === 0) {
        firmasEl.innerHTML = '<p class="cargando">Todavía no firmó nadie. Sé el primero.</p>';
        return;
      }
      for (const firma of data.firmas) {
        const node = renderFirma(firma);
        if (node) firmasEl.appendChild(node);
      }
    } catch {
      firmasEl.innerHTML = '<p class="cargando">No se pudieron cargar las firmas ahora mismo.</p>';
    }
  }

  cargarFirmas();

  form?.addEventListener("submit", async (e) => {
    e.preventDefault();
    if (errorEl) errorEl.hidden = true;

    const nombreInput = document.getElementById("gb-nombre") as HTMLInputElement;
    const mensajeInput = document.getElementById("gb-mensaje") as HTMLInputElement;
    const button = form.querySelector("button") as HTMLButtonElement;

    const mensaje = mensajeInput.value.trim();
    if (!mensaje) return;

    const turnstileInput = form.querySelector<HTMLInputElement>('input[name="cf-turnstile-response"]');
    const turnstileToken = turnstileInput?.value;
    if (!turnstileToken) {
      mostrarError("Espera a que cargue la verificación anti-bot y prueba de nuevo.");
      return;
    }

    button.disabled = true;
    try {
      const res = await fetch(API, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ nombre: nombreInput.value.trim(), mensaje, turnstileToken }),
      });

      if (!res.ok) {
        const data = await res.json().catch(() => null);
        mostrarError(data?.error || "No se pudo guardar la firma. Prueba de nuevo.");
        return;
      }

      const firma = await res.json();
      const node = renderFirma(firma);
      if (node && firmasEl) firmasEl.prepend(node);

      nombreInput.value = "";
      mensajeInput.value = "";
    } catch {
      mostrarError("No se pudo guardar la firma. Prueba de nuevo.");
    } finally {
      button.disabled = false;
      (window as any).turnstile?.reset();
    }
  });
</script>
