---
const firmasIniciales = [
  { nombre: "webmaster_1997", fecha: "12 ago", mensaje: "Buena web, se ve bien en 800x600." },
  { nombre: "anon@modem", fecha: "14 ago", mensaje: "¿Alguien más sigue tocando PHP 5.5? Ánimo con eso." },
  { nombre: "tu futuro jefe", fecha: "ayer", mensaje: "Me interesa. Te escribo." },
];
---

<section>
  <h2>Libro de visitas</h2>
  <div class="card">
    <p class="hint">Firma si has llegado hasta aquí. No se guarda en ningún sitio, es puro 1998.</p>
    <div id="firmas" class="firmas">
      {
        firmasIniciales.map((v) => (
          <div class="firma">
            <div class="autor">
              {v.nombre} <span class="fecha">· {v.fecha}</span>
            </div>
            <div class="mensaje">{v.mensaje}</div>
          </div>
        ))
      }
    </div>
    <form id="guestbook-form" class="form">
      <input id="gb-nombre" name="nombre" placeholder="Tu nombre" />
      <input id="gb-mensaje" name="mensaje" placeholder="Tu mensaje" required />
      <button type="submit">Firmar</button>
    </form>
  </div>
</section>

<template id="firma-template">
  <div class="firma">
    <div class="autor"><span data-field="nombre"></span> <span class="fecha">· justo ahora</span></div>
    <div class="mensaje" data-field="mensaje"></div>
  </div>
</template>

<style>
  h2 {
    margin: 0 0 14px;
    font-family: Georgia, serif;
    font-size: 32px;
    letter-spacing: -0.5px;
  }

  .card {
    border: 4px solid var(--ink);
    background: #fff;
    padding: 22px;
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.25);
  }

  .hint {
    margin: 0 0 16px;
    font-size: 14px;
    font-style: italic;
  }

  .firmas {
    display: grid;
    gap: 12px;
  }

  .firma {
    border-left: 6px solid var(--ac);
    padding: 4px 0 4px 14px;
  }

  .autor {
    font-size: 14px;
    font-weight: 700;
  }

  .fecha {
    font-weight: 400;
    opacity: 0.55;
  }

  .mensaje {
    font-size: 15px;
    margin-top: 3px;
  }

  .form {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
    margin-top: 20px;
  }

  input {
    font-family: "Space Mono", monospace;
    font-size: 15px;
    padding: 10px 12px;
    border: 3px solid var(--ink);
    background: var(--paper);
  }

  #gb-nombre {
    flex: 1 1 160px;
  }

  #gb-mensaje {
    flex: 2 1 240px;
  }

  button {
    font-family: "Space Mono", monospace;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    color: var(--ac);
    background: var(--ink);
    border: 3px solid var(--ink);
    padding: 10px 18px;
    box-shadow: 4px 4px 0 var(--ac);
    transition: transform 0.15s, box-shadow 0.15s;
  }

  button:hover {
    transform: translate(2px, 2px);
    box-shadow: 2px 2px 0 var(--ac);
  }
</style>

<script>
  const form = document.getElementById("guestbook-form") as HTMLFormElement | null;
  const firmas = document.getElementById("firmas");
  const template = document.getElementById("firma-template") as HTMLTemplateElement | null;

  form?.addEventListener("submit", (e) => {
    e.preventDefault();
    const nombreInput = document.getElementById("gb-nombre") as HTMLInputElement;
    const mensajeInput = document.getElementById("gb-mensaje") as HTMLInputElement;

    const mensaje = mensajeInput.value.trim();
    if (!mensaje || !firmas || !template) return;

    const nombre = nombreInput.value.trim() || "anónimo";
    const node = template.content.cloneNode(true) as DocumentFragment;
    node.querySelector<HTMLElement>('[data-field="nombre"]')!.textContent = nombre;
    node.querySelector<HTMLElement>('[data-field="mensaje"]')!.textContent = mensaje;
    firmas.appendChild(node);

    nombreInput.value = "";
    mensajeInput.value = "";
  });
</script>
