---
const texto = "★ PHP · LARAVEL · SQL ★ FIRMA EL LIBRO DE VISITAS ★";
---

<div class="marquee">
  <div class="track">{texto}</div>
</div>

<style>
  .marquee {
    border-bottom: 4px solid var(--ink);
    background: var(--ink);
    color: var(--ac);
    overflow: hidden;
    padding: 7px 0;
    font-size: 14px;
    font-weight: 700;
    white-space: nowrap;
  }

  .track {
    display: inline-block;
    animation: desliza 24s linear infinite;
  }
</style>
