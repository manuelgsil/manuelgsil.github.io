---
const puestos = [
  {
    titulo: "Desarrollador · Consejo Andaluz de Veterinarios",
    fechas: "08/2025 – hoy mismo",
    destacado: true,
    tareas: [
      "Mantenimiento de aplicaciones en PHP, de 5.5 y 7.0 hacia arriba.",
      "Migración de las herramientas de gestión del Consejo a Laravel con PHP 8.3 como suelo.",
      "SQL a diario: consultas, refactorización y bases de datos con bastante historia encima.",
      "Código legacy: entenderlo, dejarlo funcionando y que la próxima persona no sufra.",
    ],
  },
  {
    titulo: "Desarrollador (prácticas) · DSS Networks",
    fechas: "11/2024 – 03/2025",
    destacado: false,
    tareas: [
      "Refactorización y optimización de código.",
      "Mantenimiento y personalización de sitios en WordPress.",
      "Corrección de errores, pruebas y mejoras en proyectos ya en marcha.",
      "Configuración de entornos de desarrollo.",
    ],
  },
  {
    titulo: "Técnico informático (prácticas) · Grupo EULEN",
    fechas: "09/2022 – 10/2022",
    destacado: false,
    tareas: ["Consultas y actualizaciones básicas en SQL.", "Soporte técnico en call center."],
  },
];
---

<section>
  <h2>Dónde he estado</h2>
  <div class="list">
    {
      puestos.map((p) => (
        <div class="card">
          <div class="head">
            <h3>{p.titulo}</h3>
            <span class:list={["badge", { badge_dark: p.destacado }]}>{p.fechas}</span>
          </div>
          <ul>
            {p.tareas.map((t) => (
              <li>{t}</li>
            ))}
          </ul>
        </div>
      ))
    }
  </div>
</section>

<style>
  h2 {
    margin: 0 0 14px;
    font-family: Georgia, serif;
    font-size: 32px;
    letter-spacing: -0.5px;
  }

  .list {
    display: grid;
    gap: 16px;
  }

  .card {
    border: 4px solid var(--ink);
    background: #fff;
    padding: 22px;
    box-shadow: 6px 6px 0 rgba(0, 0, 0, 0.25);
  }

  .head {
    display: flex;
    flex-wrap: wrap;
    gap: 8px 14px;
    align-items: baseline;
    justify-content: space-between;
  }

  h3 {
    margin: 0;
    font-size: 19px;
    min-width: 0;
    overflow-wrap: break-word;
  }

  .badge {
    font-size: 13px;
    font-weight: 700;
    border: 2px solid var(--ink);
    padding: 3px 12px;
    white-space: nowrap;
  }

  .badge_dark {
    background: var(--ink);
    color: var(--ac);
    border-color: var(--ink);
  }

  ul {
    margin: 14px 0 0;
    padding-left: 20px;
    font-size: 15px;
    line-height: 1.75;
    display: grid;
    gap: 6px;
  }
</style>
