---
import { PROFILE } from "../data/portfolio";
---

<section id="contacto" class="section-block">
  <div class="container">
    <div class="hud-card contact-panel" data-reveal>
      <div class="contact-copy">
        <span class="section-index">04 // CONTACTO</span>
        <h2>
          Abierto a conversaciones <em>interesantes</em>
        </h2>
        <p>
          Si quieres comentar algún proyecto, contrastar un problema técnico o simplemente saludar, aquí me encuentras.
        </p>
      </div>

      <div class="contact-links">
        <a class="btn btn-primary" href={`mailto:${PROFILE.email}`}>{PROFILE.email}</a>
        <div class="contact-row">
          <a class="btn btn-ghost" href={PROFILE.github} target="_blank" rel="noopener">GitHub ↗</a>
          <a class="btn btn-ghost" href={PROFILE.linkedin} target="_blank" rel="noopener">LinkedIn ↗</a>
          <a class="btn btn-ghost" href={PROFILE.cvUrl} download>CV.PDF</a>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .contact-panel {
    padding: 36px;
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 28px;
    align-items: center;
  }

  h2 {
    margin: 10px 0 0;
    font-family: var(--font-display);
    font-weight: 700;
    font-size: clamp(28px, 3.4vw, 40px);
    line-height: 1.05;
    letter-spacing: 0.04em;
    text-transform: uppercase;
  }

  h2 em {
    font-family: var(--font-myth);
    font-style: italic;
    font-weight: 600;
    text-transform: none;
    letter-spacing: 0;
    color: var(--gold);
  }

  p {
    margin: 14px 0 0;
    font-size: 14.5px;
    color: var(--text-muted);
    max-width: 48ch;
  }

  .contact-links {
    display: flex;
    flex-direction: column;
    gap: 10px;
  }

  .contact-row {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 10px;
  }

  @media (max-width: 820px) {
    .contact-panel {
      grid-template-columns: 1fr;
      padding: 24px;
    }
  }

  @media (max-width: 480px) {
    .contact-row {
      grid-template-columns: 1fr;
    }
  }
</style>
