---
const stack = ["PHP 5.5 → 8.3", "Laravel", "SQL / MySQL", "JavaScript", "WordPress", "Git", "HTML y CSS", "Código legacy"];
---

<section>
  <h2>Con qué me peleo</h2>
  <div class="tags">
    {stack.map((t) => <span class="tag">{t}</span>)}
  </div>
</section>

<style>
  h2 {
    margin: 0 0 14px;
    font-family: Georgia, serif;
    font-size: 32px;
    letter-spacing: -0.5px;
  }

  .tags {
    display: flex;
    flex-wrap: wrap;
    gap: 10px;
  }

  .tag {
    font-size: 14px;
    font-weight: 700;
    background: #fff;
    border: 3px solid var(--ink);
    padding: 9px 14px;
    box-shadow: 3px 3px 0 var(--ink);
  }
</style>
